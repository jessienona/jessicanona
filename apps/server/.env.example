# Copy to .env and fill in as needed. Everything has a sane dev default.

PORT=4000

# Real Canon R5 FTP transfer (Menu > Network settings > FTP transfer) points here.
FTP_PORT=2121
FTP_HOST=0.0.0.0
FTP_USER=r5
FTP_PASS=tether
FTP_PASV_URL=
FTP_PASV_MIN=2122
FTP_PASV_MAX=2130

# Guest app dev server port — used to build the QR join URL when
# HOTSPOT_BASE_URL / CLOUD_BASE_URL aren't set.
GUEST_PORT=5174

# Override the join URL a QR encodes instead of auto-detecting the LAN IP.
HOTSPOT_BASE_URL=
CLOUD_BASE_URL=

# Real S3 cloud-sync target. Omit to fall back to the local-disk adapter
# (data/cloud/) — good enough to exercise the whole queue/upload flow in dev.
# npm install @aws-sdk/client-s3 -w apps/server first if you set this.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
